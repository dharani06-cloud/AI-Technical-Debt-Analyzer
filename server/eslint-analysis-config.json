{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "mocha": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": ["security"],
  "extends": ["plugin:security/recommended-legacy"],
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "complexity": ["warn", 10],
    "max-depth": ["warn", 4],
    "max-lines-per-function": ["warn", 50],
    "no-duplicate-imports": "warn"
  }
}